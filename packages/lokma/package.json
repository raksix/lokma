{
  "name": "@lokma/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Lokma - agentic coding harness CLI: terminal TUI, multi-provider login, config, doctor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raksix/lokma.git",
    "directory": "packages/lokma"
  },
  "keywords": [
    "lokma",
    "ai",
    "agent",
    "coding",
    "cli",
    "tui"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "lokma": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@lokma/ai": "workspace:*",
    "@lokma/core": "workspace:*",
    "@lokma/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.0.0"
  }
}
