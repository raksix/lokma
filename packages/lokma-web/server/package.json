{
  "name": "lokma-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Lokma web server \u2014 Fastify 5 + @fastify/websocket + REST + WS (shares SessionStore with CLI)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lokma-shared": "workspace:*",
    "lokma-core": "workspace:*",
    "lokma-ai": "workspace:*",
    "fastify": "^5.3.2",
    "@fastify/websocket": "^11.0.1",
    "@fastify/cors": "^11.0.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.1"
  }
}