{
  "name": "lokma-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lokma web harness — Vite 6 + React 19 + Tailwind v4 + shadcn/ui + WS (shares lokma-shared)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3457",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3457",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.2",
    "lucide-react": "^0.469.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "@lokma/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "vite": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.8",
    "@tailwindcss/vite": "^4.0.8",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  }
}
