{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/lib/*": [
        "src/lib/*"
      ],
      "@/hooks/*": [
        "src/hooks/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "incremental": true,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "index.html"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
